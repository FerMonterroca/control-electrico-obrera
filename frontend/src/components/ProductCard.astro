---
import type { ProductListItem } from '../types/catalog';
import { availabilityLabels, resolveMediaUrl } from '../lib/catalog';
interface Props { product: ProductListItem }
const { product } = Astro.props;
const imageUrl = resolveMediaUrl(product.primaryImageStorageKey);
---
<article class="product-card">
  <a class="product-visual" href={`/productos/${product.slug}`} tabindex="-1" aria-hidden="true">
    {imageUrl ? <img src={imageUrl} alt="" loading="lazy" /> : <div class="media-placeholder"><span>CE</span><small>Imagen próximamente</small></div>}
  </a>
  <div class="product-body">
    <div class="product-meta"><span>{product.brand?.name ?? 'Sin marca'}</span><span>{product.category.name}</span></div>
    <h3><a href={`/productos/${product.slug}`}>{product.name}</a></h3>
    {(product.model || product.skuOrCode) && <dl class="inline-specs">
      {product.model && <div><dt>Modelo</dt><dd>{product.model}</dd></div>}
      {product.skuOrCode && <div><dt>Código</dt><dd>{product.skuOrCode}</dd></div>}
    </dl>}
    <span class={`availability availability-${product.availabilityStatus.toLowerCase()}`}>{availabilityLabels[product.availabilityStatus]}</span>
    <a class="text-link" href={`/productos/${product.slug}`}>Ver producto</a>
  </div>
</article>
